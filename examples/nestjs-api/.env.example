# Copy to .env in this folder and fill in your key. .env is gitignored.

# openai | anthropic | google | xai | deepseek | groq
# "google" is Gemini, not Google Maps.
LLM_PROVIDER=groq
GROQ_API_KEY=

# Optional. Leave empty to use the provider's default model.
LLM_MODEL=

# Where "near me" is measured from. lat,lng
ORIGIN=36.801054,10.140123

PORT=3080
