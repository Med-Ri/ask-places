{
  "name": "askplaces",
  "version": "0.0.0",
  "description": "Ask a question about places in plain language and get structured JSON back, using your LLM key and OpenStreetMap.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "try:ask": "tsx scripts/try-ask.ts"
  },
  "keywords": [
    "places",
    "llm",
    "openstreetmap",
    "geocoding",
    "local-search",
    "openai"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/groq": "^4.0.77",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/xai": "^5.0.39",
    "ai": "^7.0.163",
    "zod": "^4.6.7"
  }
}
